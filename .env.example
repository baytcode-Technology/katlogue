# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storefront (subdomain routing on API; use aishopy.io in production)
STOREFRONT_BASE_DOMAIN=localhost
# Links sent to customers (WhatsApp/Instagram). Defaults to aishopy.io when BASE_DOMAIN is localhost.
# STOREFRONT_PUBLIC_BASE_DOMAIN=aishopy.io

# Google OAuth (Web client — same as Supabase Auth → Google provider).
# GOOGLE_CLIENT_ID is also used to verify native iOS/Android Google ID tokens.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Meta / WhatsApp / Instagram webhooks
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
# WHATSAPP_WEBHOOK_CALLBACK_URL=https://api.aishopy.io/webhook
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
# META_APP_SECRET=
# WHATSAPP_APP_SECRET=

# Instagram Business Login OAuth
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_OAUTH_REDIRECT_URI=https://your-api.example.com/api/instagram/oauth/callback
# INSTAGRAM_API_VERSION=v21.0
# Optional override for Instagram OAuth return URL (default: aishopyapp://instagram-oauth)
# MOBILE_DEEP_LINK_URL=aishopyapp://instagram-oauth

# Optional
# API_PUBLIC_URL=https://api.aishopy.io
# PORT=5000
# Set when behind Nginx/Caddy on EC2 (TLS termination)
# TRUST_PROXY=1
# Comma-separated origins for Socket.IO / strict CORS (Express uses cors() open by default)
# CORS_ORIGIN=https://aishopy.io,https://www.aishopy.io

# Support chat AI + inbox AI (WhatsApp / Instagram / Chat with AI)
# LLM_PROVIDER=groq | tokenbee
# LLM_PROVIDER=tokenbee
# AISHOPY_TOKENBEE=tb_live_your_key
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
#
# Platform admin — Support inbox in the AiShopy app (Settings → Support inbox)
# 1. Supabase Dashboard → Authentication → Users → copy the user's UUID
# 2. Set below (comma-separated for multiple admins)
# 3. Redeploy backend — admin must log in with that same account
# PLATFORM_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
# SUPPORT_CLEANUP_SECRET=random-secret-for-cron-fallback

# Platform Razorpay (merchant subscription billing)
# PLATFORM_RAZORPAY_KEY_ID=
# PLATFORM_RAZORPAY_KEY_SECRET=
# PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# RevenueCat (Apple IAP for AiShopy Business plan)
# Authorization header value configured in RevenueCat dashboard webhooks
# (exact match, or with Bearer prefix). Example: Bearer rc_wh_xxxx
# REVENUECAT_WEBHOOK_AUTH=Bearer rc_wh_xxxx
# Secret API key from RevenueCat → Project → API keys (used by POST /api/subscriptions/apple/sync)
# REVENUECAT_SECRET_API_KEY=
# Webhook URL to register in RevenueCat:
#   https://api.aishopy.io/api/subscriptions/revenuecat/webhook
# Product ID: aishopy_business_monthly | Entitlement: business

# Required to save merchant Razorpay keys (encrypts key secret + webhook secret at rest).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value on Railway/production — do not change after merchants have saved keys.
PAYMENT_ENCRYPTION_KEY=
